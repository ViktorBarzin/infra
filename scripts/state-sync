#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="$REPO_ROOT/state/stacks"
VAULT_ADDR="${VAULT_ADDR:-https://vault.viktorbarzin.me}"

cmd="${1:-help}"
stack="${2:-}"  # optional: operate on single stack

# Check if Vault token is valid
vault_available() {
  VAULT_ADDR="$VAULT_ADDR" vault token lookup &>/dev/null 2>&1
}

# Per-stack Transit key URI
transit_uri() {
  local stack_name="$1"
  echo "${VAULT_ADDR}/v1/transit/keys/sops-state-${stack_name}"
}

# Extract stack name from directory path
stack_name_from_dir() {
  basename "$1"
}

# Tier 0 stacks keep SOPS-encrypted local state; Tier 1 uses PG backend
TIER0_STACKS="infra platform cnpg vault dbaas external-secrets"
is_tier0() {
  echo "$TIER0_STACKS" | tr ' ' '\n' | grep -qx "$1"
}

# Read age recipients from .sops.yaml.
#
# The `2>/dev/null || echo ""` that used to end this block made a missing
# PyYAML indistinguishable from "no recipients configured", and the result was
# not a warning but an unrecoverable file: `sops -e --age ""` succeeds and
# writes state with NO age key group. The CI image had python3 but not
# py3-yaml, so every Tier-0 state CI encrypted lost its age fallback and was
# left decryptable only through Vault Transit at the in-cluster address CI
# records. Four of the six were in that condition on 2026-09-16, dbaas among
# them, which is the stack the runbooks name as the recovery path when
# Postgres is down.
#
# Stderr is kept so the real error is visible, and encrypt_state refuses an
# empty list below. py3-yaml is now in ci/Dockerfile.
AGE_RECIPIENTS="$(python3 -c "
import yaml, sys
with open('$REPO_ROOT/.sops.yaml') as f: c = yaml.safe_load(f)
for r in c.get('creation_rules', []):
    age = r.get('age', '')
    if age:
        print(age.replace('\n', '').strip())
        break
" || echo "")"

encrypt_state() {
  local dir="$1"
  local src="$dir/terraform.tfstate"
  local dst="$dir/terraform.tfstate.enc"
  local name
  name="$(stack_name_from_dir "$dir")"
  [ -f "$src" ] || return 0

  # Refuse to encrypt a state file that is empty or not valid JSON. Terraform
  # reads a 0-byte state as "no resources exist", so encrypting one over a good
  # .enc replaces a stack's entire state with nothing. The old guard was
  # `[ -f "$src" ]` alone, which a 0-byte file passes, and the mtime test below
  # treats a freshly-truncated file as newer and therefore worth encrypting.
  # A failed decrypt used to leave exactly such a file (see decrypt_state), so
  # decrypt-then-encrypt was a two-command path to an empty state. Recoverable,
  # because the .enc is committed, but silent, which is the part worth fixing.
  if [ ! -s "$src" ]; then
    echo "state-sync: REFUSING to encrypt $name — $src is empty." >&2
    echo "  A 0-byte state means Terraform would plan to create every resource" >&2
    echo "  in this stack. Restore it with: git checkout -- $dst" >&2
    return 1
  fi
  if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$src" 2>/dev/null; then
    echo "state-sync: REFUSING to encrypt $name — $src is not valid JSON." >&2
    return 1
  fi

  # Refuse to encrypt without an age recipient. Vault Transit alone is not a
  # recoverable configuration: sops records the Transit ADDRESS in the file and
  # reuses it over $VAULT_ADDR, so a state encrypted in-cluster becomes
  # readable only from in-cluster. Tier 0 exists to bootstrap the cluster, so
  # that is precisely backwards. An empty list here means .sops.yaml could not
  # be read (usually a missing PyYAML), never that no recipients are wanted.
  if [ -z "$AGE_RECIPIENTS" ]; then
    echo "state-sync: REFUSING to encrypt $name — no age recipients resolved from .sops.yaml." >&2
    echo "  Encrypting with Vault Transit alone produces a state file that can only be" >&2
    echo "  decrypted from wherever it was encrypted. Check that PyYAML is importable:" >&2
    echo "    python3 -c 'import yaml'" >&2
    return 1
  fi

  # Only re-encrypt if state is newer than encrypted version
  if [ ! -f "$dst" ] || [ "$src" -nt "$dst" ]; then
    sops -e --input-type json --output-type json \
      --hc-vault-transit "$(transit_uri "$name")" \
      --age "$AGE_RECIPIENTS" \
      "$src" > "$dst"
  fi
}

# Decrypt to a temp file and only move it into place once it is non-empty and
# valid JSON.
#
# This used to redirect sops straight onto the real state file. The shell
# truncates a redirect target BEFORE the command runs, so a failed decrypt left
# a 0-byte terraform.tfstate where the state had been. Measured 2026-09-16:
# one `state-sync decrypt` per stack produced four of them across platform,
# cnpg, dbaas and external-secrets. `scripts/tg` survives it (its `set -e`
# catches the exit 128 and aborts before terragrunt runs), but the truncated
# file stays on disk, and `encrypt` would then happily seal it over the good
# .enc. That second half is now refused too, see encrypt_state.
#
# The age fallback also keyed on the WRONG condition. It asked "is Vault
# reachable", not "did the Vault decrypt work", and those differ: sops records
# the Transit key's ADDRESS at encrypt time and reuses it verbatim, so a file
# encrypted in-cluster carries http://vault-active.vault.svc.cluster.local:8200
# and cannot be decrypted from the devvm no matter how valid the token is.
# With a good token the old code took the Vault branch, failed on DNS, and
# never tried the age key that was sitting on disk. It now falls back whenever
# the Vault attempt fails, for any reason.
decrypt_state() {
  local dir="$1"
  local src="$dir/terraform.tfstate.enc"
  local dst="$dir/terraform.tfstate"
  local tmp
  [ -f "$src" ] || return 0

  local age_key="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
  tmp="$(mktemp "${dst}.XXXXXX")"
  # The temp file carries decrypted state, so remove it on every exit path.
  trap 'rm -f "$tmp"' RETURN

  local got=false
  if vault_available; then
    if sops -d --input-type json --output-type json "$src" > "$tmp" 2>/dev/null; then
      got=true
    else
      echo "state-sync: Vault Transit decrypt failed for $(stack_name_from_dir "$dir")" >&2
    fi
  fi

  if [ "$got" = false ] && [ -f "$age_key" ]; then
    echo "state-sync: trying the age key" >&2
    if SOPS_AGE_KEY_FILE="$age_key" \
        sops -d --input-type json --output-type json "$src" > "$tmp" 2>/dev/null; then
      got=true
    fi
  fi

  if [ "$got" = false ]; then
    echo "state-sync: ERROR — could not decrypt $src." >&2
    echo "  Tried Vault Transit at the address recorded IN THE FILE (not \$VAULT_ADDR)" >&2
    echo "  and the age key at $age_key." >&2
    echo "  A file encrypted inside the cluster records an in-cluster Vault address" >&2
    echo "  and needs an age recipient to be readable from anywhere else." >&2
    echo "  $dst was left untouched." >&2
    return 1
  fi

  if [ ! -s "$tmp" ]; then
    echo "state-sync: ERROR — decrypt produced an empty file, refusing to install it." >&2
    return 1
  fi
  if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$tmp" 2>/dev/null; then
    echo "state-sync: ERROR — decrypt produced invalid JSON, refusing to install it." >&2
    return 1
  fi

  mv -f "$tmp" "$dst"
}

case "$cmd" in
  encrypt)
    if [ -n "$stack" ]; then
      if is_tier0 "$stack"; then
        encrypt_state "$STATE_DIR/$stack"
      else
        echo "state-sync: skipping Tier 1 stack '$stack' (PG backend)" >&2
      fi
    else
      for dir in "$STATE_DIR"/*/; do
        _name="$(stack_name_from_dir "$dir")"
        if is_tier0 "$_name"; then
          encrypt_state "$dir"
        fi
      done
    fi
    ;;
  decrypt)
    if [ -n "$stack" ]; then
      if is_tier0 "$stack"; then
        decrypt_state "$STATE_DIR/$stack"
      else
        echo "state-sync: skipping Tier 1 stack '$stack' (PG backend)" >&2
      fi
    else
      for dir in "$STATE_DIR"/*/; do
        _name="$(stack_name_from_dir "$dir")"
        if is_tier0 "$_name"; then
          decrypt_state "$dir"
        fi
      done
    fi
    ;;
  commit)
    # Only Tier 0 stacks have encrypted state in git
    "$0" encrypt
    cd "$REPO_ROOT"
    git add state/stacks/*/terraform.tfstate.enc
    if ! git diff --cached --quiet; then
      git commit -m "state: update encrypted terraform state"
    fi
    ;;
  help)
    echo "Usage: state-sync {encrypt|decrypt|commit} [stack-name]"
    echo "Operates on Tier 0 stacks only (infra, platform, cnpg, vault, dbaas, external-secrets)."
    echo "Tier 1 stacks use the PG backend and don't need local state sync."
    echo "Encrypt uses per-stack Vault Transit key (transit/keys/sops-state-<stack>)."
    echo "Decrypt uses Vault Transit if logged in, falls back to age key."
    ;;
esac
