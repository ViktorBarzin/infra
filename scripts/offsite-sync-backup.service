[Unit]
Description=Daily offsite sync: sda + NFS changes to Synology
After=network-online.target daily-backup.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/offsite-sync-backup
StandardOutput=journal
StandardError=journal
SyslogIdentifier=offsite-sync-backup
TimeoutStartSec=7200
# Idle IO class (2026-11-10). At best-effort this ran against etcd on the
# shared sdc spindle and stalled it 13 of 14 nights (memory #17075, measured
# 2026-11-04). mq-deadline honours IO priority for reads on this kernel, so
# idle reads yield to etcd and the VMs. nfs-mirror and devvm-home-backup were
# already idle.
Nice=10
IOSchedulingClass=idle
