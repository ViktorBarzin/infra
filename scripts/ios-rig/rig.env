# iOS test rig — shared configuration.
# Sourced by both the Mac-side and devvm-side scripts.

# The device under test.
IOS_RIG_UDID="${IOS_RIG_UDID:-00008110-001614D03442801E}"
IOS_RIG_DEVICE_NAME="${IOS_RIG_DEVICE_NAME:-Empress Anca}"

# The Mac that holds the cable. DHCP, and it roams between the London Flint
# LAN (192.168.8.0/24) and the Hyperoptic guest network (192.168.9.0/24), so
# this is overridable and `ios-rig discover` will find it again.
IOS_RIG_MAC_HOST="${IOS_RIG_MAC_HOST:-192.168.9.225}"
IOS_RIG_MAC_USER="${IOS_RIG_MAC_USER:-viktorbarzin}"

# Free Apple ID personal team. Certificates last 7 days.
IOS_RIG_TEAM_ID="${IOS_RIG_TEAM_ID:-26NB4W97WL}"
IOS_RIG_SIGNING_ID="${IOS_RIG_SIGNING_ID:-Apple Development}"
IOS_RIG_WDA_BUNDLE_ID="${IOS_RIG_WDA_BUNDLE_ID:-me.viktorbarzin.wda}"

# Meta ships its own Xcode build. xcode-select points at CommandLineTools and
# changing that needs sudo we do not have, so every Xcode call sets
# DEVELOPER_DIR explicitly instead.
IOS_RIG_DEVELOPER_DIR="${IOS_RIG_DEVELOPER_DIR:-/Applications/Xcode_26.6.0_17F113_fb.app/Contents/Developer}"

# Appium's port on the Mac, forwarded to the same port on the devvm.
IOS_RIG_APPIUM_PORT="${IOS_RIG_APPIUM_PORT:-4723}"

# WebDriverAgent's URL is NOT configured here. The phone takes a DHCP lease and
# WDA rebinds on every restart, so the runner publishes whatever it bound to in
# ~/.ios-rig-wda-url on the Mac and `ios-rig wda-url` reads it back.
