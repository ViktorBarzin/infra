#!/usr/bin/env bash
# Revoke or restore agent-api's external callers, immediately.
#
# Two halves, and both are needed. Removing the line from the live
# credentials file takes effect on the NEXT REQUEST (authuser reads the file
# per request, measured: 200 -> 401 in under a second, no restart). Clearing
# the Vault key is what stops the next devvm.yml run putting it straight back.
# Doing only the first gives you a kill that silently undoes itself.
#
#   agent-api-kill            revoke every external credential
#   agent-api-kill --restore  put them back from Vault
#   agent-api-kill --status   who can call right now
set -euo pipefail

FILE=/etc/terminal-lobby-tokens
VAULT_PATH=secret/terminal-lobby
FIELD=agent_api_muse_token
HELD=agent_api_muse_token_revoked
BACKUP=/etc/terminal-lobby-tokens.revoked

probe() { curl -s -o /dev/null -w '%{http_code}' -m 5 \
  -H "Authorization: Bearer ${1:-none}" http://127.0.0.1:8710/v1/conversations || echo 000; }

case "${1:-revoke}" in
  --status)
    echo "credentials live in $FILE:"
    sudo grep -vE '^\s*(#|$)' "$FILE" | awk '{print "  " $1 " -> " $3}' || echo "  (none)"
    echo "vault $VAULT_PATH/$FIELD: $(vault kv get -field=$FIELD $VAULT_PATH 2>/dev/null | wc -c) bytes"
    ;;
  --restore)
    TOK=$(vault kv get -field=$FIELD $VAULT_PATH 2>/dev/null || true)
    [ -z "$TOK" ] && TOK=$(vault kv get -field=$HELD $VAULT_PATH 2>/dev/null || true)
    if [ -z "$TOK" ]; then
      echo "vault holds no token, live or held; mint one first:" >&2
      echo "  vault kv patch $VAULT_PATH $FIELD=\$(openssl rand -base64 36 | tr '+/' '._')" >&2
      exit 1
    fi
    vault kv patch "$VAULT_PATH" "$FIELD=$TOK" >/dev/null 2>&1 || true
    D=$(printf %s "$TOK" | sha256sum | awk '{print $1}')
    printf '# Managed by playbooks/devvm.yml. Local edits are overwritten.\nmuse sha256:%s wizard\n' "$D" \
      | sudo tee "$FILE" >/dev/null
    sudo chown root:wizard "$FILE"; sudo chmod 0640 "$FILE"
    echo "restored. probe with the live token: $(probe "$TOK")  (200 = callable)"
    ;;
  revoke)
    TOK=$(vault kv get -field=$FIELD $VAULT_PATH 2>/dev/null || true)
    sudo cp -f "$FILE" "$BACKUP" 2>/dev/null || true
    printf '# Revoked by agent-api-kill. No external caller may authenticate.\n' | sudo tee "$FILE" >/dev/null
    sudo chown root:wizard "$FILE"; sudo chmod 0640 "$FILE"
    # The token is HELD, not destroyed: a kill you cannot undo without
    # re-onboarding the caller is a kill nobody reaches for in time. Clearing
    # the live field is what stops the next devvm.yml run restoring it.
    if [ -n "$TOK" ]; then vault kv patch "$VAULT_PATH" "$HELD=$TOK" >/dev/null 2>&1 || true; fi
    vault kv patch "$VAULT_PATH" "$FIELD=" >/dev/null 2>&1 \
      && echo "vault key cleared (token held at $HELD), so a playbook run will not restore it" \
      || echo "WARNING: could not clear the vault key; a playbook run WILL restore the credential" >&2
    if [ -n "$TOK" ]; then
      echo "verified: the old token now gets HTTP $(probe "$TOK")  (401 = revoked)"
    fi
    echo "previous file kept at $BACKUP"
    ;;
  *) echo "usage: agent-api-kill [--status|--restore]" >&2; exit 2 ;;
esac
