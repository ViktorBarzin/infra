#!/usr/bin/env bash
# Refresh this user's local copy of their hub's logins.
#
# One hub per person (docs/architecture/chrome-service.md "One hub per person"):
# a cluster Chrome holding that person's logins. ~/.config/chrome-hub/hub.json
# (installed by t3-provision-users from /etc/t3-serve/chrome-hub-<user>.json)
# names it: snapshot_url and read_token. The snapshot lands in
# ~/.cache/playwright-shared-storage-state.json, which every terminal-lobby
# session browser (tl-browser) and the T3 browser sync seed from.
#
# Run hourly by playwright-snapshot-refresh@<user>.timer as that user. The
# lobby's cookie write-back also rewrites the same file after each push, so
# both take flock on the .lock file beside it and never interleave.
#
# A user without hub.json has no hub: nothing to do, exit 0.
set -euo pipefail

HUB="${CHROME_HUB_CONFIG:-$HOME/.config/chrome-hub/hub.json}"
DEST="${PLAYWRIGHT_SNAPSHOT_PATH:-$HOME/.cache/playwright-shared-storage-state.json}"
LOCK="$DEST.lock"

if [ ! -r "$HUB" ]; then
  echo "no hub config at $HUB: this user has no hub, nothing to refresh"
  exit 0
fi
URL="$(jq -r '.snapshot_url // empty' "$HUB")"
TOKEN="$(jq -r '.read_token // empty' "$HUB")"
if [ -z "$URL" ] || [ -z "$TOKEN" ]; then
  echo "ERROR: $HUB lacks snapshot_url or read_token" >&2
  exit 1
fi

mkdir -p "$(dirname "$DEST")"
TMP="$DEST.new.$$"
trap 'rm -f "$TMP"' EXIT

HTTP_CODE=$(curl -sS \
  -H "Authorization: Bearer $TOKEN" \
  -o "$TMP" \
  -w '%{http_code}' \
  --max-time 30 \
  "$URL")

if [ "$HTTP_CODE" != "200" ]; then
  echo "ERROR: HTTP $HTTP_CODE from $URL" >&2
  head -c 300 "$TMP" >&2 || true
  exit 1
fi

# Sanity: response must be valid JSON with at least the cookies/origins keys.
python3 - "$TMP" <<'PY' || { echo "ERROR: response is not a valid storageState JSON" >&2; exit 1; }
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
if "cookies" not in data or "origins" not in data:
    raise SystemExit("missing required keys")
PY

chmod 600 "$TMP"
(
  flock -w 30 9
  mv -f "$TMP" "$DEST"
) 9>"$LOCK"
trap - EXIT
echo "snapshot refreshed: $DEST ($(stat -c %s "$DEST") bytes)"
