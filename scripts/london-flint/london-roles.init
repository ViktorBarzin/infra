#!/bin/sh /etc/rc.common
# procd service for /usr/bin/london-roles (scripts/london-flint/london-roles.sh).
# Installed by scripts/london-flint/provision.sh.
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/london-roles run
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
