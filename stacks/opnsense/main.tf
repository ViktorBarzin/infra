# OPNsense edge-firewall VM (ADR-0038, docs/plans/2026-11-03-opnsense-migration.md).
#
# The first VM back in Terraform since the 2026-05-26 decision to keep VMs out
# (telmate/proxmox rewrote disk lists and corrupted k8s-node2/3; compute.md).
# That decision named bpg/proxmox as the way back, and this stack is scoped so
# a provider bug cannot reach another VM:
#   - the stack holds this one VM;
#   - the token (Vault secret/opnsense pve_api_token, user
#     terraform-opnsense@pve, privilege-separated) has the TFOpnsense role on
#     /vms/100, /storage/local, /storage/local-lvm, /nodes/pve and
#     /sdn/zones/localnetwork only;
#   - prevent_destroy on the VM.
#
# The root terragrunt.hcl declares the local name "proxmox" for the telmate
# provider, so bpg is "proxmoxbpg" here and every resource names it; see
# terragrunt.hcl for why this stack does not include the root config.
#
# Configuration inside the VM is Ansible's job (playbooks/opnsense.yml); this
# stack owns the hardware only.

# required_providers (vault, bpg/proxmox as "proxmoxbpg") are generated by this
# stack's terragrunt.hcl.

data "vault_kv_secret_v2" "opnsense" {
  mount = "secret"
  name  = "opnsense"
}

provider "proxmoxbpg" {
  endpoint  = "https://192.168.1.127:8006/"
  api_token = data.vault_kv_secret_v2.opnsense.data["pve_api_token"]
  # PVE's self-signed certificate, as for the telmate provider in stacks/infra.
  insecure = true
}

locals {
  opnsense_version = "26.7"
  # SHA256 of OPNsense-26.7-nano-amd64.img.bz2 from the release's signed
  # checksum list (OPNsense-26.7-checksums-amd64.sha256, signature verified
  # against OPNsense-26.7.pub on 2026-11-03).
  nano_bz2_sha256 = "28d5e2f37e40d87468a924e3006ef10e2ddc6de485b85333d9e3958c84d0cb9d"
  nano_volid      = "local:import/opnsense-${local.opnsense_version}-nano-amd64.raw"

  # NICs in pfSense's order with pfSense's MACs, which the 2026-11-10 cutover
  # (scripts/opnsense-cutover) moved here so the TP-Link forwards and every
  # neighbour cache kept working. A rebuild starts with disconnected = true and
  # flips one at a time, VLAN 20 first and the home LAN (wan) last:
  # docs/runbooks/opnsense.md.
  nics = [
    { name = "wan", bridge = "vmbr0", vlan = null, mac = "BC:24:11:D7:3F:BA", disconnected = false },
    { name = "lan", bridge = "vmbr1", vlan = 10, mac = "BC:24:11:48:40:B9", disconnected = false },
    { name = "opt1", bridge = "vmbr1", vlan = 20, mac = "BC:24:11:A9:F9:04", disconnected = false },
    { name = "opt4", bridge = "vmbr0", vlan = 30, mac = "BC:24:11:86:D0:A7", disconnected = false },
  ]
}

# Puts the nano image into `local` as import content (scripts/opnsense-image-upload).
# Runs once; the script is a no-op when the volume already exists, so CI never
# re-uploads.
resource "terraform_data" "nano_image" {
  triggers_replace = [local.nano_volid, local.nano_bz2_sha256]

  provisioner "local-exec" {
    command = "${path.module}/../../scripts/opnsense-image-upload ${local.opnsense_version} ${local.nano_bz2_sha256}"
  }
}

resource "proxmox_virtual_environment_vm" "opnsense" {
  provider    = proxmoxbpg
  depends_on  = [terraform_data.nano_image]
  name        = "opnsense"
  node_name   = "pve"
  vm_id       = 100
  description = "OPNsense edge firewall (staging until cutover). Managed by stacks/opnsense (ADR-0038); configuration by playbooks/opnsense.yml."
  tags        = ["opnsense", "edge-firewall", "terraform"]

  on_boot = true
  started = true
  # Boot ordering (`startup`) is owned by playbooks/reboot-boot-order.yml, not
  # here: PVE requires Sys.Modify on / to set it ("changes host behaviour",
  # PVE/API2/Qemu.pm), which this stack's token deliberately lacks.
  stop_on_destroy = true

  bios          = "seabios"
  scsi_hardware = "virtio-scsi-single"

  cpu {
    cores = 8
    type  = "host"
  }

  memory {
    dedicated = 8192
  }

  operating_system {
    type = "other"
  }

  agent {
    enabled = false
  }

  disk {
    interface    = "scsi0"
    datastore_id = "local-lvm"
    import_from  = local.nano_volid
    size         = 32
    discard      = "on"
    iothread     = true
  }

  boot_order = ["scsi0"]

  # The nano image's console is serial (115200); the socket is how the
  # bootstrap import is driven (scripts/opnsense-bootstrap-serial).
  serial_device {
    device = "socket"
  }

  dynamic "network_device" {
    for_each = local.nics
    content {
      bridge       = network_device.value.bridge
      vlan_id      = network_device.value.vlan
      mac_address  = network_device.value.mac
      model        = "virtio"
      firewall     = true
      disconnected = network_device.value.disconnected
    }
  }

  lifecycle {
    prevent_destroy = true
    # The import source matters only at creation; later image versions are
    # firmware updates inside OPNsense, not a new disk.
    ignore_changes = [disk[0].import_from, startup]
  }
}

output "mac_addresses" {
  value = proxmox_virtual_environment_vm.opnsense.mac_addresses
}
