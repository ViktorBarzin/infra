# wine-app contract for Hikvision iVMS-4200 V3 (Windows client).
# Sourced by the wine-app entrypoint; every variable here is exported to Wine.
APP_NAME=ivms
APP_VERSION=3.14.1.4
APP_INSTALLER_URL='https://www.hikvision.com/content/dam/hikvision/en/support/download/vms/ivms4200-series/software-download/v3-14-1-4/iVMS-4200V3.14.1.4_E.exe'
APP_INSTALLER_SHA256=ec52309a182a943e070b199915943c42b4e052c692949dcc4532e37077588679
# Hikvision's CDN answers 403 "Missing timestamp or signature" without it.
APP_INSTALLER_REFERER='https://www.hikvision.com/en/support/download/software/ivms4200-series/'
APP_LAUNCH='C:\Program Files (x86)\iVMS-4200 Site\iVMS-4200 Client\Client\iVMS-4200.Framework.C.exe'
# Login, first-run and main windows are all titled "iVMS-4200".
APP_READY_WINDOW='^iVMS-4200$'
APP_WINETRICKS='corefonts'
# The client starts its own background servers (Framework.S, WatchDog, nginx).
APP_SERVICES_WAIT=0
# The video decoder subprocess (DecodeProcess.exe) cannot find CrashAPI.dll
# and CommonMethodLib.dll without the client directory on the DLL path.
WINEPATH='C:\Program Files (x86)\iVMS-4200 Site\iVMS-4200 Client\Client'
