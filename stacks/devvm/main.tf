# Terraform-built devvm VMs (modules/proxmox-devvm), from the disposable-devvm
# plan (docs/plans/2026-11-11-disposable-devvm.md): "build a devvm" is one
# apply, and a throwaway drill proves the rebuild every few months.
#
# The live devvm (VMID 102, 10.0.10.10) is NOT in this stack, not imported, and
# outside the reach of its token: the token (Vault secret/devvm pve_api_token,
# user terraform-devvm@pve, privilege-separated, declared by
# playbooks/pve-host.yml tag devvm-tf) holds the TFDevvm role on /pool/devvm,
# the VMID slots 9100-9109 and the storage, network and node paths only, and
# 102 is neither in that pool nor a slot.
# The module also refuses the live name, VMID, address and MAC.
#
# A drill: add an entry to local.drills, land it, let CI apply, check the box,
# remove the entry, land again. docs/runbooks/devvm-drill.md has the steps and
# what to check. With no drills the stack holds only the Ubuntu image
# (~600 MB in `local`).

# required_providers (vault, bpg/proxmox as "proxmoxbpg") are generated by this
# stack's terragrunt.hcl.

data "vault_kv_secret_v2" "devvm" {
  mount = "secret"
  name  = "devvm"
}

# The admin's keys, the same list the playbook installs on the live devvm.
data "vault_kv_secret_v2" "authorized_keys" {
  mount = "secret"
  name  = "devvm-authorized-keys"
}

locals {
  pve_endpoint = "https://192.168.1.127:8006/"

  # Ubuntu 24.04 cloud image, pinned. SHA256 from that release's SHA256SUMS,
  # whose signature was checked against ubuntu-cloudimage-keyring.gpg on
  # 2026-11-11 ("Good signature from UEC Image Automatic Signing Key").
  image_release = "20261017"
  image_sha256  = "04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94"

  # Plain key lines only; option-prefixed lines (forced commands) arrive with
  # the playbook's full list.
  admin_ssh_keys = [
    for k in split("\n", data.vault_kv_secret_v2.authorized_keys.data["wizard"]) :
    trimspace(k) if startswith(trimspace(k), "ssh-")
  ]

  # Drills: a VM with its own name, a VMID in 9100-9109 (the slots the token is
  # granted; anything else gets 403 at create; a slot is re-granted within a
  # minute of a destroy, so wait that long before reusing one in a new
  # apply) and an address below VLAN 10's DHCP pool
  # (.100-.254). An entry that leaves out cores, memory_mb or disk_gb gets
  # 4 cores, 8 GiB and 80 GiB, which build fine and fit the host (267 GiB,
  # 40 GiB available on 2026-11-11; the live devvm's 32 GiB would leave about
  # 8). Check `free -g` on the host first (runbook). The replacement sets the
  # full size explicitly. Everything else is the live devvm's shape (module
  # defaults).
  drills = {
    # Test of the host-key path (round 3, host identity): the live devvm's SSH
    # host keys on a drill address. Removed again once its fingerprints are
    # checked against the live box's.
    "devvm-drill-hostkeys" = {
      vm_id          = 9101
      ipv4_cidr      = "10.0.10.14/24"
      cores          = 2
      memory_mb      = 4096
      live_host_keys = true
    }
  }
}

provider "proxmoxbpg" {
  endpoint  = local.pve_endpoint
  api_token = data.vault_kv_secret_v2.devvm.data["pve_api_token"]
  # PVE's self-signed certificate, as in stacks/opnsense.
  insecure = true
}

# Kept between drills. Deleting a file from `local` needs Datastore.Allocate
# there, which would also let the token delete every backup, ISO and the
# OPNsense image on that storage, so the token does not have it (the first
# teardown failed with that 403). The cost is that bumping image_release
# leaves the old file behind and the apply fails deleting it: remove it as
# root (`pvesm free local:import/<old file>`) and re-apply.
resource "proxmox_download_file" "ubuntu" {
  provider           = proxmoxbpg
  node_name          = "pve"
  datastore_id       = "local"
  content_type       = "import"
  file_name          = "noble-server-cloudimg-amd64-${local.image_release}.qcow2"
  url                = "https://cloud-images.ubuntu.com/noble/${local.image_release}/noble-server-cloudimg-amd64.img"
  checksum           = local.image_sha256
  checksum_algorithm = "sha256"
  overwrite          = false
}

module "drill" {
  source   = "../../modules/proxmox-devvm"
  for_each = local.drills

  name        = each.key
  vm_id       = each.value.vm_id
  ipv4_cidr   = each.value.ipv4_cidr
  cores       = try(each.value.cores, 4)
  memory_mb   = try(each.value.memory_mb, 8192)
  disk_gb     = try(each.value.disk_gb, 80)
  infra_ref   = try(each.value.infra_ref, "master")
  on_boot     = try(each.value.on_boot, false)
  mac_address = try(each.value.mac_address, null)
  # Only for the replacement once VM 102 is gone (runbook, last section).
  # It also brings the live devvm's SSH host keys from Vault.
  allow_live_identity = try(each.value.allow_live_identity, false)
  # A drill that tests the host-key path: the live keys on a drill address.
  # Take it off again after the check (runbook, "Building the real replacement").
  live_host_keys = try(each.value.live_host_keys, false)
  description = (try(each.value.allow_live_identity, false)
    ? "The devvm workstation, rebuilt from stacks/devvm. Protected: PVE refuses to destroy it until root clears the flag (docs/runbooks/devvm-drill.md, replacement)."
  : "Throwaway devvm drill (docs/runbooks/devvm-drill.md). Delete by removing it from stacks/devvm local.drills.")

  image_file_id  = proxmox_download_file.ubuntu.id
  admin_ssh_keys = local.admin_ssh_keys
  pve_endpoint   = local.pve_endpoint
  pve_api_token  = data.vault_kv_secret_v2.devvm.data["pve_api_token"]
}

moved {
  from = proxmox_download_file.ubuntu[0]
  to   = proxmox_download_file.ubuntu
}

output "drills" {
  value = { for k, m in module.drill : k => { vm_id = m.vm_id, address = m.address, live_host_keys = m.live_host_keys } }
}
