<clickhouse>
    <!-- default (password from CLICKHOUSE_PASSWORD, set by the image entrypoint)
         is the admin: schema changes and the backup CronJob. -->
    <profiles>
        <ingest>
            <max_memory_usage>1500000000</max_memory_usage>
            <deduplicate_blocks_in_dependent_materialized_views>1</deduplicate_blocks_in_dependent_materialized_views>
        </ingest>
        <!-- Agents write the reader's queries, so it gets limits: a stray
             SELECT * over raw must not take the server down. -->
        <reader>
            <readonly>2</readonly>
            <max_execution_time>120</max_execution_time>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_result_rows>100000</max_result_rows>
            <result_overflow_mode>break</result_overflow_mode>
            <max_result_bytes>200000000</max_result_bytes>
        </reader>
        <!-- netsec (docs/architecture/network-security-monitoring.md): the
             Vector in stacks/netsec writes NetFlow, Suricata and proxy rows. -->
        <netsec_writer>
            <max_memory_usage>1000000000</max_memory_usage>
            <date_time_input_format>best_effort</date_time_input_format>
        </netsec_writer>
    </profiles>
    <!-- A runaway source (a NetFlow loop, an EVE storm) is refused here before
         it fills the disk. Sized at about 10x the 2026-11-10 rates: 99 NetFlow
         records/s is ~45 MB/h uncompressed; EVE metadata adds a similar amount. -->
    <quotas>
        <netsec_writer>
            <interval>
                <duration>3600</duration>
                <written_bytes>4000000000</written_bytes>
                <query_inserts>20000</query_inserts>
                <errors>2000</errors>
            </interval>
        </netsec_writer>
    </quotas>
    <users>
        <ingest>
            <password from_env="CLAUDE_SESSIONS_INGEST_PASSWORD"/>
            <profile>ingest</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT INSERT ON claude.lines</query>
                <query>GRANT INSERT ON claude.files</query>
                <query>GRANT INSERT ON claude.home_files</query>
                <query>GRANT INSERT ON claude.home_lines</query>
            </grants>
        </ingest>
        <reader>
            <password from_env="CLAUDE_SESSIONS_READER_PASSWORD"/>
            <profile>reader</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON claude.*</query>
            </grants>
        </reader>
        <netsec_writer>
            <password from_env="NETSEC_WRITER_PASSWORD"/>
            <profile>netsec_writer</profile>
            <quota>netsec_writer</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT INSERT ON netsec.*</query>
                <!-- netsec-technitium (stacks/netsec) reads its watermark and
                     pulls Technitium's Postgres log with postgresql(). -->
                <query>GRANT SELECT ON netsec.technitium</query>
                <query>GRANT CREATE TEMPORARY TABLE, POSTGRES ON *.*</query>
            </grants>
        </netsec_writer>
        <!-- Viktor only: /etc/netsec/reader.env on the devvm is root:sudo 0640
             and he is the only member of sudo (playbooks/devvm.yml). -->
        <netsec_reader>
            <password from_env="NETSEC_READER_PASSWORD"/>
            <profile>reader</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON netsec.*</query>
            </grants>
        </netsec_reader>
        <!-- The netsec alert job (stacks/netsec CronJob netsec-alerts) reads
             alerts only, to post home-host malware hits to Alertmanager. -->
        <netsec_alerts>
            <password from_env="NETSEC_ALERTS_PASSWORD"/>
            <profile>reader</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <grants>
                <query>GRANT SELECT ON netsec.eve</query>
            </grants>
        </netsec_alerts>
    </users>
</clickhouse>
