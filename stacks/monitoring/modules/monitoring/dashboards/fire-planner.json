      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wealth-app-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  tax_year AS \"Tax year\",\n  max(liquid_net_worth) FILTER (WHERE percentile = 10) AS \"p10\",\n  max(liquid_net_worth) FILTER (WHERE percentile = 25) AS \"p25\",\n  max(liquid_net_worth) FILTER (WHERE percentile = 50) AS \"p50 (median)\",\n  max(liquid_net_worth) FILTER (WHERE percentile = 75) AS \"p75\",\n  max(liquid_net_worth) FILTER (WHERE percentile = 90) AS \"p90\"\nFROM grafana.sweep_bands\nWHERE plan_id::text = '$plan' AND variant = '$variant'\nGROUP BY tax_year\nORDER BY tax_year"
        }
      ]
