  "description": "FIRE planning from wealth (wealth.viktorbarzin.me): Viktor's household's Plans, their newest Sweeps and account values, read through the views in schema grafana of the wealth database (datasource wealth-app-pg).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "id": null,
  "templating": {
    "list": [
      {
        "name": "plan",
        "type": "query",
        "label": "Plan",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wealth-app-pg"
        },
        "definition": "Plans with a Sweep (wealth)",
        "query": "SELECT plan_id::text AS __value, plan AS __text FROM grafana.sweep_outcomes GROUP BY plan_id, plan, is_main ORDER BY is_main DESC, plan",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      },
      {
        "name": "variant",
        "type": "query",
        "label": "Sweep variant",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "wealth-app-pg"
        },
        "definition": "variants of the Plan's newest Sweep (wealth)",
        "description": "A variant of the Plan's newest Sweep. The Plan's own country, strategy and glide path come first.",
        "query": "SELECT so.variant FROM grafana.sweep_outcomes so JOIN grafana.plans p ON p.plan_id = so.plan_id WHERE so.plan_id::text = '$plan' ORDER BY (so.home_country AND so.strategy = p.strategy) DESC, so.position",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 6,
      "type": "stat",
      "title": "Optimal leave-UK year",
      "description": "The move of the non-UK variant with the best success rate less median lifetime tax / 1,000,000 (fire-planner's score), in the Plan's newest Sweep. Tax years start on 6 April.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "wealth-app-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Best move$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wealth-app-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(move_tax_year || '/' || lpad(((move_tax_year + 1) % 100)::text, 2, '0'), 'No move') || ' to ' || CASE country WHEN 'uk' THEN 'UK' WHEN 'uae' THEN 'UAE' WHEN 'usa' THEN 'USA' ELSE initcap(replace(country, '_', ' ')) END AS \"Best move\"\nFROM grafana.sweep_outcomes WHERE plan_id::text = '$plan' AND country <> 'uk'\nORDER BY success_rate - median_lifetime_tax / 1000000.0 DESC, position\nLIMIT 1"
        }
      ]
    },
