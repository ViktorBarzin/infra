{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-user page visits through proxy.viktorbarzin.me (spec infra#83). Full URL + title, 90-day retention. Filter by user with the User variable (regex).",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Page visits (selected range)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "instant",
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum(count_over_time({namespace=\"proxy\", container=\"visit-collector\"} | json | kind=\"nav\" | user=~\"$user\" [$__range]))"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Visits over time (by user)",
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{user}}",
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum by (user) (count_over_time({namespace=\"proxy\", container=\"visit-collector\"} | json | kind=\"nav\" | user=~\"$user\" [$__auto]))"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "normal" } }, "unit": "short" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Recent visits — user · URL · title (newest first)",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "{namespace=\"proxy\", container=\"visit-collector\"} | json | kind=\"nav\" | user=~\"$user\" | line_format \"{{.user}}  |  {{.url}}  |  {{.title}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": ["proxy", "visits", "security"],
  "templating": {
    "list": [
      {
        "name": "user",
        "type": "textbox",
        "label": "User (regex)",
        "description": "Filter to one user (Authentik username). Default matches all.",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "title": "Proxy visits",
  "uid": "proxy-visits",
  "version": 1,
  "weekStart": ""
}
