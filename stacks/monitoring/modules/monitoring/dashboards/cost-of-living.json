      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "wealth-app-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT city AS \"City\", country AS \"Country\", source AS \"Source\", chosen AS \"In use\", snapshot_date AS \"Snapshot\", fetched_at AS \"Fetched\",\n  fetched_at + interval '7 days' AS \"Refresh due\", expires_at AS \"Expires\", (expires_at::date - current_date) AS \"Expires in\"\nFROM grafana.cost_of_living\nORDER BY \"Expires in\" NULLS LAST, city, source"
