          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT l.city AS \"City\", l.country AS \"Country\", l.total AS \"Total monthly\", l.essentials AS \"Without rent\", l.rent_1bed AS \"1-bed rent\",\n  (l.total / b.total)::numeric(8,3) AS \"Ratio vs baseline\", l.source AS \"Source\", l.snapshot_date AS \"Snapshot\"\nFROM grafana.cost_of_living l\nCROSS JOIN (SELECT total FROM grafana.cost_of_living WHERE slug = '$baseline_city' AND chosen) b\nWHERE l.chosen\nORDER BY l.total"
