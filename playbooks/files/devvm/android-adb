#!/bin/bash
# android-adb <device> [ip]: connect adb to a family Android device over the site tunnels and
# print the adb serial. Tries the fixed port 5555 (set by 'adb tcpip 5555', lost on reboot), then
# scans for the wireless-debugging port, which changes after every restart. Pass the IP if the
# device moved. Each device runs an Automate flow that keeps wireless debugging switched on.
# Devices:
#   milka          Milka's phone, Valchedrym (or Mladost 3)
#                  docs/plans/2026-10-09-milka-remote-phone-help-design.md
#   london-tablet  Xiaomi Pad 7 in the London flat
#                  docs/plans/2026-11-22-london-tablet-design.md
# Uses its own adb server on port 5039 with the one key every device here trusts,
# ~/.android/milka-adbkey (wizard's adbkey; emo has a copy), so it never mixes with a user's
# other adb devices. Use the same two variables for your own adb commands:
#   export ADB_SERVER_SOCKET=tcp:localhost:5039 ADB_VENDOR_KEYS=$HOME/.android/milka-adbkey
#   adb -s "$(android-adb london-tablet)" shell ...
set -u
export ADB_SERVER_SOCKET=tcp:localhost:5039 ADB_VENDOR_KEYS=$HOME/.android/milka-adbkey
case "${1:-}" in
  milka) DEFAULT_IP=192.168.0.193 ;;
  london-tablet) DEFAULT_IP=192.168.8.188 ;;
  *) echo "usage: android-adb milka|london-tablet [ip]" >&2; exit 2 ;;
esac
IP=${2:-$DEFAULT_IP}
try() { timeout 8 adb connect "$IP:$1" >/dev/null 2>&1; sleep 2
  [ "$(adb devices | awk -v d="$IP:$1" '$1==d{print $2}')" = device ] && { echo "$IP:$1"; exit 0; }
  adb disconnect "$IP:$1" >/dev/null 2>&1; }
# A sleeping device answers in hundreds of ms and its first TLS handshake can fail (seen
# 2026-10-11: "Handshake failed in SSL_accept" on the right port, which worked a minute later),
# so wake its Wi-Fi with a few pings and go over the open ports up to three times.
wake() { ping -c 3 -W 2 "$IP" >/dev/null 2>&1; }
wake; try 5555
ports=$(nmap -Pn -p 30000-50000 -T4 --max-retries 3 "$IP" 2>/dev/null | grep -oE '^[0-9]+/tcp open' | cut -d/ -f1)
for pass in 1 2 3; do
  [ "$pass" = 1 ] || wake
  for p in $ports; do try "$p"; done
done
echo "no adb on $IP (device off, not yet unlocked since boot, or on another network)" >&2; exit 1
