#!/bin/bash
# Claude Code SessionStart hook, machine-wide (managed-settings.json), installed
# by playbooks/devvm.yml as /usr/local/libexec/claude-presence/session-start.
#
# Writes a session id where the other two hooks and `presence` itself find it:
# $HOME/.cache/claude-presence/current.session. $HOME makes it per OS user, and
# the id starts with the user name, so two people's sessions never share an id
# or a heartbeat stamp.
#
# One session per user at a time: the session started last wins. Set
# CLAUDE_SESSION_ID in a shell to run two in parallel.
set -uo pipefail

DIR="${PRESENCE_STATE_DIR:-$HOME/.cache/claude-presence}"
mkdir -p "$DIR" || exit 0

RAND="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
SESSION_ID="$(id -un)@$(hostname -s)@${RAND}"

printf '%s' "$SESSION_ID" > "$DIR/current.session"
exit 0
