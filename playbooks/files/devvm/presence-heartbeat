#!/bin/bash
# Claude Code PostToolUse hook, machine-wide (managed-settings.json), installed
# by playbooks/devvm.yml as /usr/local/libexec/claude-presence/heartbeat.
#
# Extends the TTL on this session's active claims so they do not expire while
# the session is working. Runs after every tool call, so it is throttled to one
# database call per 120 s per session and does nothing else in between.
set -uo pipefail

PRESENCE="${PRESENCE_BIN:-/usr/local/bin/presence}"
DIR="${PRESENCE_STATE_DIR:-$HOME/.cache/claude-presence}"
SESSION_FILE="$DIR/current.session"
[[ -r "$SESSION_FILE" ]] || exit 0

SESSION_ID="$(cat "$SESSION_FILE")"
[[ -n "$SESSION_ID" ]] || exit 0
# Kept beside the session file, in the user's own home: a stamp in the shared
# /tmp is owned by whoever made it first.
STAMP="$DIR/last-heartbeat"

NOW=$(date +%s)
LAST=$(stat -c %Y "$STAMP" 2>/dev/null || echo 0)
if (( NOW - LAST < 120 )); then
    exit 0
fi
touch "$STAMP"

CLAUDE_SESSION_ID="$SESSION_ID" "$PRESENCE" heartbeat >/dev/null 2>&1 || true
exit 0
