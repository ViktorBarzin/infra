[Unit]
Description=Re-divide the disk between whoever is actually using it

[Timer]
# THE INTERVAL IS THE REACTION TIME. It is the worst case for how long one
# user keeps the whole device after a second person starts working, and during
# that window the interference this script exists to prevent can happen.
#
# 2 minutes, set 2026-09-13. The history is worth keeping, because the number
# has been wrong in both directions: 30s originally, then 10min on 2026-09-12
# when Viktor judged 30s wasteful, then back to 2min the next day once the
# cost of being slow to react became the visible one. Measured again the same
# day, three runs: 0.09-0.11s wall, ~0.10s CPU each. So the three settings
# cost 0.33%, 0.017% and 0.083% of ONE core, against 32 cores. The saving
# between 10min and 2min is 0.002% of the box; the reaction time bought with
# it is five times better.
#
# Below about a minute the numbers stop being the argument and the churn
# starts: io.max is rewritten on every run, and a user flipping between
# capped and uncapped every 30s is its own kind of unpredictable.
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
