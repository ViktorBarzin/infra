[Unit]
Description=Hourly check of the films on the London tablet

[Timer]
# Hourly (Viktor, 2026-11-22): a deleted film leaves Stremio's Downloaded row
# within the hour. Away from home the addon keeps the last list.
OnCalendar=hourly
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
