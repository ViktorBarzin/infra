#!/bin/bash
# Claude Code Stop hook, machine-wide (managed-settings.json), installed by
# playbooks/devvm.yml as /usr/local/libexec/claude-presence/release.
#
# Releases every active claim this session holds when the agent finishes its
# turn. The session is the one named in the hook input (session_id), so a turn
# ending in one session never releases another session's claims. Best effort:
# it never blocks the session.
set -uo pipefail

PRESENCE="${PRESENCE_BIN:-/usr/local/bin/presence}"
DIR="${PRESENCE_STATE_DIR:-$HOME/.cache/claude-presence}"

SID="$(grep -o '"session_id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/')"
SID="${SID:-${CLAUDE_CODE_SESSION_ID:-}}"
[[ "$SID" =~ ^[A-Za-z0-9._-]+$ ]] || exit 0

CLAUDE_CODE_SESSION_ID="$SID" "$PRESENCE" release --all-mine >/dev/null 2>&1 || true
rm -f "$DIR/heartbeat-$SID"
exit 0
