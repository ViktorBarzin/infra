#!/usr/bin/env python3
"""Tell the Stremio download-row addon which films are on the London tablet.

Lists the video files in the tablet's Downloads folder over adb and POSTs
their names, sizes and times to the addon (stacks/servarr/aiostreams,
files/download_row.py), which turns the ones it named into an "On the tablet" row
in Stremio and a "▶ On the tablet" row that opens the file in VLC. Only video
files in that one folder are sent; the folder belongs to Anca's profile.

Run hourly by tablet-downloads-sync.timer as wizard, whose ~/.android/milka-adbkey
the tablet trusts. When the tablet is away or off, it exits 0 and the addon
keeps the last list: that is the normal case on a trip, not a failure.

Environment: DOWNLOAD_ROW_INVENTORY_URL (in /etc/tablet-downloads/env).
Test: python3 playbooks/files/devvm/tablet-downloads-sync-test.py
"""
import json
import os
import subprocess
import sys
import urllib.request

FOLDER = "/sdcard/Download"
# toybox find and stat on HyperOS 3 (Android 16); hidden names are Chrome's
# and MediaStore's partial downloads.
LIST = (
    f"find {FOLDER} -maxdepth 1 -type f ! -name '.*' "
    r"\( -iname '*.mkv' -o -iname '*.mp4' -o -iname '*.avi' -o -iname '*.m4v' \) "
    "-exec stat -c '%s|%Y|%n' {} +"
)


def parse(text: str) -> list[dict]:
    files = []
    for line in text.splitlines():
        parts = line.split("|", 2)
        if len(parts) != 3 or not parts[0].isdigit() or not parts[1].isdigit():
            continue
        files.append({"name": os.path.basename(parts[2]), "size": int(parts[0]), "mtime": int(parts[1])})
    return files


def payload(files: list[dict]) -> dict:
    return {"dir": FOLDER, "files": files}


def main() -> int:
    env = dict(os.environ, ADB_SERVER_SOCKET="tcp:localhost:5039",
               ADB_VENDOR_KEYS=os.path.expanduser("~/.android/milka-adbkey"))
    found = subprocess.run(["android-adb", "london-tablet"], capture_output=True, text=True, env=env, timeout=300)
    serial = found.stdout.strip()
    if found.returncode != 0 or not serial:
        print("tablet not reachable; the addon keeps the last list")
        return 0
    listing = subprocess.run(["adb", "-s", serial, "shell", LIST], capture_output=True, text=True, env=env, timeout=120)
    if listing.returncode != 0:
        print(f"listing failed: {listing.stderr.strip()}", file=sys.stderr)
        return 1
    files = parse(listing.stdout)
    request = urllib.request.Request(
        os.environ["DOWNLOAD_ROW_INVENTORY_URL"],
        data=json.dumps(payload(files)).encode(),
        headers={"Content-Type": "application/json", "User-Agent": "tablet-downloads-sync"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        print(f"sent {len(files)} files: {response.status}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
