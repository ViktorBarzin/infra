#!/usr/bin/env python3
"""Agent presence board CLI.

Lets Claude Code agent sessions claim, heartbeat, release, list, and peek at
shared infra resource claims so that two sessions don't unknowingly mutate
the same thing at the same time.

Installed machine-wide as /usr/local/bin/presence by infra playbooks/devvm.yml
(source: playbooks/files/devvm/presence; tests: presence-test.py beside it).
A claim belongs to one Claude Code session: <user>@<host>@<session uuid>,
from the CLAUDE_CODE_SESSION_ID that Claude Code exports to every command it
runs. The heartbeat and release hooks in /etc/claude-code/managed-settings.json
read the same uuid from their hook input, so concurrent sessions of one user
never extend or release each other's claims.

A subagent runs with its parent's CLAUDE_CODE_SESSION_ID, so on its own it
would share the parent's identity, and sibling subagents would never see each
other's claims as conflicts. The PreToolUse hook presence-tag-agent reads the
subagent's agent_id from the hook input (Claude Code passes it to hooks, not
to the commands a subagent runs) and exports it as PRESENCE_AGENT_ID into that
subagent's presence and homelab commands. Its id is then
<user>@<host>@<session uuid>/<agent id>. The SubagentStop hook releases it.
A claim held by the session's own parent, or by a subagent it sent, is not
reported as a conflict: they work on the same task. Siblings still are.

Reads from env:
  PRESENCE_DSN            mysql DSN (default: beads@10.0.20.200:3306/beads)
  CLAUDE_SESSION_ID       full session identity, overrides everything below
  CLAUDE_CODE_SESSION_ID  the Claude Code session uuid (set by Claude Code)
  PRESENCE_AGENT_ID       the subagent's id (set by presence-tag-agent)
Outside Claude Code, with neither session variable set, every run gets a
one-shot id, <user>@<host>@shell-<8 hex>. `release <label>` from such a shell
drops the same OS user's shell claim on that label on this host; a claim held
by a Claude session needs that session's id in CLAUDE_SESSION_ID.

The heartbeat and release hooks have a 3 s timeout, so a down database must
fail well inside it: the connect and every read and write give up after 1 s,
and presence then warns and exits 0.
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import re
import socket
import sys
import urllib.parse
import uuid

try:
    import pymysql
    import pymysql.cursors
except ImportError:
    pymysql = None  # graceful: handled in _connect

_DB_ERRORS: tuple[type[BaseException], ...] = (pymysql.MySQLError,) if pymysql else ()

DEFAULT_DSN = "mysql://beads@10.0.20.200:3306/beads"
DEFAULT_TTL_SECONDS = 15 * 60
# Below the hooks' 3 s timeout with room for Python's start-up. A reachable
# database answers in milliseconds (7 ms connect, 2 ms query, 2026-10-30).
DB_TIMEOUT_SECONDS = 1
SHELL_ID_MARK = "shell-"
_TOKEN = re.compile(r"^[A-Za-z0-9._-]+$")


def _prefix() -> str:
    return f"{getpass.getuser()}@{_host()}"


def _host() -> str:
    return socket.gethostname().split(".")[0]


def _agent_id() -> str | None:
    agent = os.environ.get("PRESENCE_AGENT_ID", "")
    return agent if _TOKEN.match(agent) else None


def in_plain_shell() -> bool:
    return not (os.environ.get("CLAUDE_SESSION_ID") or os.environ.get("CLAUDE_CODE_SESSION_ID"))


def get_session_id() -> str:
    """Return this session's id: <user>@<host>@<Claude Code session uuid>,
    with /<agent id> appended inside a subagent."""
    env = os.environ.get("CLAUDE_SESSION_ID")
    if env:
        return env
    claude = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if claude:
        agent = _agent_id()
        return f"{_prefix()}@{claude}/{agent}" if agent else f"{_prefix()}@{claude}"
    # Outside Claude Code: a one-shot id, which no hook will heartbeat or release.
    return f"{_prefix()}@{SHELL_ID_MARK}{uuid.uuid4().hex[:8]}"


def parent_session_id() -> str | None:
    """The parent session's id when running inside a subagent, else None."""
    claude = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if os.environ.get("CLAUDE_SESSION_ID") or not claude or not _agent_id():
        return None
    return f"{_prefix()}@{claude}"


def same_session(other: str, session_id: str) -> bool:
    """True when the claim `other` belongs to this session's own family: the
    parent that sent this subagent, or a subagent this session sent. Those
    work together, so their claims on one label are not a conflict. Sibling
    subagents and other sessions still are."""
    return other == parent_session_id() or other.startswith(f"{session_id}/")


def _like_prefix(text: str) -> str:
    return text.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="presence",
        description="Agent presence board for coordinating shared-infra mutations.",
    )
    p.add_argument("--json", action="store_true", help="emit machine-readable output")
    sub = p.add_subparsers(dest="verb", required=True)

    c = sub.add_parser("claim", help="claim a resource you're about to mutate")
    c.add_argument("label", help="resource label, e.g. node:k8s-node1")
    c.add_argument("--purpose", required=True, help="what + why")
    c.add_argument("--ttl", type=int, default=DEFAULT_TTL_SECONDS, help="seconds")

    sub.add_parser("heartbeat", help="extend TTL on all my active claims")

    r = sub.add_parser("release", help="release one or all of my claims")
    r.add_argument("label", nargs="?", help="resource label; omit with --all-mine")
    r.add_argument("--all-mine", action="store_true")

    li = sub.add_parser("list", help="show active claims")
    g = li.add_mutually_exclusive_group()
    g.add_argument("--mine", action="store_true", help="only my session's claims")
    g.add_argument("--all", action="store_true", help="all sessions' claims (default)")

    pe = sub.add_parser("peek", help="show all active claims on a resource")
    pe.add_argument("label", help="resource label")

    return p


def _connect():
    if pymysql is None:
        print(
            "presence: warning: pymysql not installed; the devvm playbook "
            "installs it as the apt package python3-pymysql",
            file=sys.stderr,
        )
        return None
    dsn = os.environ.get("PRESENCE_DSN", DEFAULT_DSN)
    u = urllib.parse.urlparse(dsn)
    try:
        return pymysql.connect(
            host=u.hostname,
            port=u.port or 3306,
            user=u.username or "beads",
            password=u.password or "",
            database=(u.path.lstrip("/") or "beads"),
            cursorclass=pymysql.cursors.DictCursor,
            connect_timeout=DB_TIMEOUT_SECONDS,
            read_timeout=DB_TIMEOUT_SECONDS,
            write_timeout=DB_TIMEOUT_SECONDS,
            autocommit=True,
        )
    except pymysql.MySQLError as e:
        _warn_unreachable(e)
        return None


def _warn_unreachable(e: Exception) -> None:
    print(f"presence: warning: dolt unreachable ({e}); continuing", file=sys.stderr)


def _claim(args, session_id: str) -> int:
    conn = _connect()
    if conn is None:
        return 0  # graceful degradation
    with conn.cursor() as cur:
        cur.execute(
            """
            REPLACE INTO presence_claims
                (session_id, resource_label, purpose, claimed_at, expires_at, host, user, agent_name)
            VALUES
                (%s, %s, %s, NOW(3), NOW(3) + INTERVAL %s SECOND, %s, %s, %s)
            """,
            (
                session_id,
                args.label,
                args.purpose,
                args.ttl,
                socket.gethostname().split(".")[0],
                getpass.getuser(),
                "claude-code",
            ),
        )
        cur.execute(
            """
            SELECT session_id, purpose, claimed_at, user, host
              FROM presence_claims
             WHERE resource_label = %s
               AND session_id    != %s
               AND expires_at    >  NOW(3)
             ORDER BY claimed_at
            """,
            (args.label, session_id),
        )
        conflicts = [c for c in cur.fetchall() if not same_session(c["session_id"], session_id)]
    if not conflicts:
        print(f"presence: claimed {args.label}")
        return 0
    print(f"presence: claimed {args.label} -- ALSO CLAIMED BY:")
    for c in conflicts:
        print(f"  - {c['session_id']} ({c['user']}@{c['host']}): {c['purpose']} since {c['claimed_at']}")
    print("presence: per CLAUDE.md rule, default is to DEFER -- release your claim and confirm with the user.")
    return 0


def _peek(args, session_id: str) -> int:
    conn = _connect()
    if conn is None:
        return 0
    with conn.cursor() as cur:
        cur.execute(
            """
            SELECT session_id, purpose, claimed_at, expires_at, user, host
              FROM presence_claims
             WHERE resource_label = %s
               AND expires_at    >  NOW(3)
             ORDER BY claimed_at
            """,
            (args.label,),
        )
        rows = cur.fetchall()
    if not rows:
        print(f"presence: no active claim on {args.label}")
        return 0
    print(f"presence: active claims on {args.label}:")
    for r in rows:
        marker = " (me)" if r["session_id"] == session_id else ""
        print(f"  - {r['session_id']}{marker} ({r['user']}@{r['host']}): {r['purpose']} since {r['claimed_at']} (expires {r['expires_at']})")
    return 0


def _list(args, session_id: str) -> int:
    conn = _connect()
    if conn is None:
        return 0
    query = """
        SELECT session_id, resource_label, purpose, claimed_at, expires_at, user, host
          FROM presence_claims
         WHERE expires_at > NOW(3)
    """
    params: tuple = ()
    if args.mine:
        query += " AND session_id = %s"
        params = (session_id,)
    query += " ORDER BY claimed_at"
    with conn.cursor() as cur:
        cur.execute(query, params)
        rows = cur.fetchall()
    if args.json:
        out = []
        for r in rows:
            out.append({
                "session_id":      r["session_id"],
                "resource_label":  r["resource_label"],
                "purpose":         r["purpose"],
                "claimed_at":      str(r["claimed_at"]),
                "expires_at":      str(r["expires_at"]),
                "user":            r["user"],
                "host":            r["host"],
                "is_me":           r["session_id"] == session_id,
            })
        print(json.dumps(out))
        return 0
    if not rows:
        print("presence: no active claims")
        return 0
    for r in rows:
        marker = " (me)" if r["session_id"] == session_id else ""
        print(f"  {r['resource_label']:<32} {r['session_id']}{marker} -- {r['purpose']} ({r['claimed_at']})")
    return 0


def _heartbeat(args, session_id: str) -> int:
    conn = _connect()
    if conn is None:
        return 0
    # A subagent also keeps its parent's claims alive: the parent makes no tool
    # calls while it waits on its subagents, so its own heartbeat is quiet.
    ids = (session_id, parent_session_id() or session_id)
    with conn.cursor() as cur:
        cur.execute(
            """
            UPDATE presence_claims
               SET expires_at = NOW(3) + INTERVAL %s SECOND
             WHERE session_id IN (%s, %s)
               AND expires_at > NOW(3)
            """,
            (DEFAULT_TTL_SECONDS, *ids),
        )
    return 0


def _release(args, session_id: str) -> int:
    if not args.all_mine and not args.label:
        print("presence: release requires <label> or --all-mine", file=sys.stderr)
        return 2
    conn = _connect()
    if conn is None:
        return 0
    shell_ids = _like_prefix(f"{_prefix()}@{SHELL_ID_MARK}") + "%"
    with conn.cursor() as cur:
        if args.all_mine:
            n = cur.execute("DELETE FROM presence_claims WHERE session_id = %s", (session_id,))
            if in_plain_shell():
                n += cur.execute(
                    "DELETE FROM presence_claims WHERE user = %s AND host = %s AND session_id LIKE %s",
                    (getpass.getuser(), _host(), shell_ids),
                )
            print(f"presence: released {n} claim(s)")
            return 0
        n = cur.execute(
            "DELETE FROM presence_claims WHERE session_id = %s AND resource_label = %s",
            (session_id, args.label),
        )
        if not n and in_plain_shell():
            # This run's one-shot id never claimed anything; the shell that
            # claimed had its own. Drop this user's plain-shell claim instead.
            n = cur.execute(
                "DELETE FROM presence_claims"
                " WHERE resource_label = %s AND user = %s AND host = %s AND session_id LIKE %s",
                (args.label, getpass.getuser(), _host(), shell_ids),
            )
        if n:
            print(f"presence: released {args.label}")
            return 0
        cur.execute(
            """
            SELECT session_id, user, host
              FROM presence_claims
             WHERE resource_label = %s
               AND expires_at    >  NOW(3)
             ORDER BY claimed_at
            """,
            (args.label,),
        )
        holders = cur.fetchall()
    print(f"presence: no claim on {args.label} held by {session_id}; nothing released", file=sys.stderr)
    for h in holders:
        if h["user"] == getpass.getuser():
            print(
                f"presence: {h['session_id']} holds it; to release it: "
                f"CLAUDE_SESSION_ID={h['session_id']} presence release {args.label}",
                file=sys.stderr,
            )
        else:
            print(f"presence: {h['session_id']} ({h['user']}@{h['host']}) holds it", file=sys.stderr)
    return 1


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    # propagate top-level --json onto args.json (no-op if already there)
    args.json = bool(getattr(args, "json", False))
    session_id = get_session_id()
    try:
        return _dispatch(args, session_id)
    except _DB_ERRORS as e:  # a timeout or a dropped connection mid-query
        _warn_unreachable(e)
        return 0


def _dispatch(args, session_id: str) -> int:
    if args.verb == "claim":
        return _claim(args, session_id)
    if args.verb == "peek":
        return _peek(args, session_id)
    if args.verb == "list":
        return _list(args, session_id)
    if args.verb == "heartbeat":
        return _heartbeat(args, session_id)
    if args.verb == "release":
        return _release(args, session_id)
    print(f"verb={args.verb} not yet implemented", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
