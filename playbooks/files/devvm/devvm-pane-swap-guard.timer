[Unit]
Description=Reconcile tmux pane swap protection every 5 minutes

[Timer]
# 5 minutes is chosen against the thing being tracked. Panes are marked hot for
# 24 hours, so the window moves slowly and a pane created just after a run waits
# at most 5 minutes for protection. Tighter would add writes without changing
# any outcome.
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
# No Persistent=. It only applies to OnCalendar=, and on a monotonic timer it
# does harm: systemd restores the pre-reboot "last triggered" stamp, and with a
# stamp present an OnBootSec point that passed before the timer started is
# dropped as already used. OnUnitActiveSec then never arms because the service
# never ran. On 2026-10-23 the timer started 221s after boot, past this 3min.

[Install]
WantedBy=timers.target
