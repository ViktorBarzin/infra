#!/bin/sh
# tmux-guard: installed as /usr/local/bin/tmux, ahead of /usr/bin/tmux on PATH.
# Refuses `kill-server` when it would reach the user's default server, which
# holds every Terminal Lobby session. Everything else goes straight to the real
# tmux.
#
# Why: on 2026-10-06 an agent's e2e script set TMUX_TMPDIR to a private
# directory and ran `tmux kill-server` to stop its own test server. It ran in a
# lobby pane, so $TMUX was set, and tmux picks the socket named in $TMUX over
# TMUX_TMPDIR. It killed wizard's real server twice in one day. A Claude Code
# hook cannot catch this, because the command sat inside a script file.
#
# A private server is still free to die: use -L <name> or -S <path>, or unset
# TMUX first. To kill the default server on purpose, set TMUX_KILL_SERVER_OK=1
# or call /usr/bin/tmux directly. Tests: tmux-guard-test.sh beside this file.
REAL="${TMUX_GUARD_REAL:-/usr/bin/tmux}"

# Fast path: no kill-server anywhere in argv, nothing to decide.
hit=
for a in "$@"; do
  case "$a" in kill-ser|kill-serv|kill-serve|kill-server) hit=1; break ;; esac
done
[ -z "$hit" ] && exec "$REAL" "$@"
[ "${TMUX_KILL_SERVER_OK:-}" = 1 ] && exec "$REAL" "$@"

# Walk the global flags the way tmux 3.4 does (getopt "2c:CDdf:lL:NqS:T:uUvV").
label='' sock='' cmdpos='' want=''
i=0
for a in "$@"; do
  i=$((i + 1))
  if [ -n "$want" ]; then
    case "$want" in L) label="$a" ;; S) sock="$a" ;; esac
    want=; continue
  fi
  [ -n "$cmdpos" ] && continue
  case "$a" in
    --) cmdpos=$((i + 1)) ;;
    -L) want=L ;;
    -L*) label="${a#-L}" ;;
    -S) want=S ;;
    -S*) sock="${a#-S}" ;;
    -c|-f|-T) want=skip ;;
    -?*) ;;
    *) cmdpos=$i ;;
  esac
done

# kill-server only counts in command position: the first word after the flags,
# or the first word after a ';' separator. `new -s kill-server` is a session name.
killing='' i=0 next=''
for a in "$@"; do
  i=$((i + 1))
  [ -z "$cmdpos" ] || [ "$i" -lt "$cmdpos" ] && continue
  if [ "$i" -eq "$cmdpos" ] || [ -n "$next" ]; then
    next=
    case "$a" in kill-ser|kill-serv|kill-serve|kill-server) killing=1 ;; esac
  fi
  case "$a" in *\;) next=1 ;; esac
done
[ -z "$killing" ] && exec "$REAL" "$@"

uid="$(id -u)"
if [ -z "$sock" ]; then
  if [ -n "$label" ]; then sock="${TMUX_TMPDIR:-/tmp}/tmux-$uid/$label"
  elif [ -n "${TMUX:-}" ]; then sock="${TMUX%%,*}"
  else sock="${TMUX_TMPDIR:-/tmp}/tmux-$uid/default"
  fi
fi

if [ "$sock" = "/tmp/tmux-$uid/default" ]; then
  cat >&2 <<EOF
tmux-guard: refusing kill-server on $sock.
  That is your main tmux server and it holds every lobby session.
  \$TMUX is ${TMUX:-unset}; when it is set, tmux uses that socket and ignores TMUX_TMPDIR.
  For a private test server use 'tmux -L <name> ...' or 'tmux -S <path> ...'.
  To kill the main server on purpose: TMUX_KILL_SERVER_OK=1 tmux kill-server
EOF
  exit 1
fi
exec "$REAL" "$@"
