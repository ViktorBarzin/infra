version: 0.1
log:
  fields:
    service: registry
storage:
  cache:
    blobdescriptor: inmemory
  filesystem:
    rootdirectory: /var/lib/registry
  delete:
    enabled: true
  maintenance:
    uploadpurging:
      enabled: true
      age: 24h
      interval: 4h
      dryrun: false
    readonly:
      enabled: false
http:
  addr: :5000
  draintimeout: 60s
  headers:
    X-Content-Type-Options: [nosniff]
  debug:
    addr: ":5001"
    # Enable proxy on nodes - https://github.com/containerd/containerd/blob/main/docs/cri/registry.md
    # https://ops.tips/gists/retrieving-docker-registry-metrics-using-prometheus/
    prometheus:
      enabled: true
      path: "/metrics"
health:
  storagedriver:
    enabled: true
    interval: 10s
    threshold: 3
# The Docker Hub pull-through credentials come from Vault at apply time, never
# from git. They were plaintext in this file on the live box; the GitHub mirror
# of this repo is public, and this path is not one of the git-crypt patterns in
# .gitattributes, so committing them here would publish a live PAT.
#
#   vault kv get -field=dockerhub_username secret/registry-cache
#   vault kv get -field=dockerhub_token    secret/registry-cache
#
# An authenticated pull-through cache is what keeps the whole cluster off Docker
# Hub's anonymous rate limit, so an empty value here is a real outage rather than
# a degraded mode. playbooks/registry-cache.yml asserts both are non-empty before
# it renders this file.
proxy:
  remoteurl: https://registry-1.docker.io
  username: {{ registry_cache_dockerhub_username }}
  password: {{ registry_cache_dockerhub_token }}
  ttl: 168h
